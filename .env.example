# --- Server ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=

# --- Azure AD (auth) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure Blob Storage (incident attachments) ---
# Storage account name, e.g. prsciencetrustvehicles
AZURE_STORAGE_ACCOUNT_NAME=
# Storage account key — used to sign SAS tokens. Keep secret.
AZURE_STORAGE_ACCOUNT_KEY=
# Default container for incident attachments
AZURE_STORAGE_INCIDENT_CONTAINER=incident-attachments
# How long upload SAS URLs remain valid (browser PUT window)
AZURE_STORAGE_SAS_UPLOAD_TTL_MINUTES=15
# How long read SAS URLs remain valid (preview/download window)
AZURE_STORAGE_SAS_READ_TTL_MINUTES=60

# --- Anthropic (Claude Vision OCR for license fields) ---
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for license OCR; overridable. Defaults to a current-cap Sonnet.
ANTHROPIC_LICENSE_OCR_MODEL=claude-sonnet-4-6

# --- EHS Training Reservations (app separada, mismo backend/DB, montada en /api/ehs-training) ---
# Usa su propio app registration en Entra ID (no el de AZURE_TENANT_ID/AZURE_CLIENT_ID de arriba).
EHS_MOCK_AUTH=false
EHS_SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo
EHS_ADMIN_EMAILS=admin@prsciencetrust.org
EHS_AZURE_TENANT_ID=
EHS_AZURE_CLIENT_ID=

# --- Invitacion de calendario al reservar (opcional) ---
# Si se dejan vacios, la reservacion funciona igual pero no se envia invitacion.
# EHS_AZURE_CLIENT_SECRET: secreto de la misma app de Entra ID de arriba (requiere
# permiso de aplicacion Calendars.ReadWrite con consentimiento de administrador).
# EHS_GRAPH_ORGANIZER_MAILBOX: buzon compartido que aparece como organizador de la
# invitacion, ej. adiestramientos@prsciencetrust.org
EHS_AZURE_CLIENT_SECRET=
EHS_GRAPH_ORGANIZER_MAILBOX=
